{
  "name": "openloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "node scripts/models.mjs",
    "test:live": "node scripts/live-test.mjs",
    "worker": "tsx scripts/anubandh-worker.ts",
    "test:e2e": "playwright test",
    "test:anubandh": "vitest run tests/anubandh.test.ts",
    "hermes:setup": "bash scripts/hermes/setup.sh",
    "test:hermes:live": "tsx scripts/hermes/live-check.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.5",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.544.0",
    "next": "16.3.7",
    "openai": "^5.20.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
