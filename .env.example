# Put the real credential in .env.local, never in this template.
NEBIUS_API_KEY=

# Verified in the account catalog; refresh availability with npm run models.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Local persistence. Do not expose this unauthenticated prototype publicly.
DATABASE_PATH=.data/openloop.db
ANUBANDH_DATABASE_PATH=.data/anubandh/family.db
ANUBANDH_STORAGE_PATH=.data/anubandh

# Optional photo understanding. Text briefings continue to use NEBIUS_MODEL.
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
TOGETHERLY_PHOTO_DAILY_LIMIT=10

# fixture | token-factory
AI_PROVIDER=fixture
